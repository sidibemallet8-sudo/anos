{
  "name": "anos",
  "version": "1.0.0-beta",
  "description": "ANOS - Intelligent compression for AI, reducing carbon footprint and optimizing efficiency globally",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "anos": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "test": "node --test dist/test/*.test.js",
    "test:unit": "node --test dist/test/unit/*.test.js",
    "test:integration": "node --test dist/test/integration/*.test.js",
    "bench": "node dist/benchmarks/performance.js",
    "start": "node dist/cli.js",
    "demo": "node dist/examples/basic.js",
    "dev": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "compression",
    "ai",
    "ml",
    "model",
    "pytorch",
    "tensorflow",
    "carbon",
    "sustainability",
    "efficiency",
    "quantization",
    "optimization"
  ],
  "author": "Malet Sidibe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidibemallet8-sudo/anos.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^5.0.0",
    "progress": "^2.0.3",
    "pino": "^8.0.0",
    "crypto-js": "^4.2.0"
  }
}
